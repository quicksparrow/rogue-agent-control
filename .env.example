# Black Box and synthetic fixtures need no credentials. Real shopping needs local Ollama.
DATABASE_PATH=./data/rogue-control.sqlite
# Phase 2 local model. Keep this listener on loopback.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_OUTPUT_TOKENS=1536
OLLAMA_THINK=false
OLLAMA_TIMEOUT_MS=90000
SHOPPING_TIMEOUT_MS=240000
SHOPPING_MAX_STEPS=5
ROGUE_OWNER_ID=local_buyer
ROGUE_AGENT_ID=shopping_qwen3
# Optional Phase 2 live discovery. Never use NEXT_PUBLIC_ for this key.
CHANNEL3_API_KEY=
